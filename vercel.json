{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "DATABASE_URL": "sqlite:////tmp/assessments.db",
    "CORS_ORIGINS": "https://danieldemoz.github.io,http://localhost:3000"
  }
}
